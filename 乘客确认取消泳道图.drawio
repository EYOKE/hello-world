        <mxCell id="footer1" value="实线：动作内处理或结果流转　　虚线：异步触发。城际、不判责及内部豁免等存在跳过或短路分支。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#25313d;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1686.0" width="783" height="32" />

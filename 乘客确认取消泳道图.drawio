        <mxCell id="note1" value="上、下两类入口分别触发，不表示整页按时间串行执行" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#25313d;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="347.0" y="729.0" width="426" height="32" />
        </mxCell>
        <mxCell id="footer0" value="登记动作负责写取消记录；消息消费依赖已有记录。二者与费用 Action 的执行关系取决于策略配置。" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=17;fontColor=#25313d;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1659.0" width="851" height="32" />
